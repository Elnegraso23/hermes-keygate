#!/bin/bash
# keygate-setup: create operative vault (keyfile-only, NO master) + agent KeePassXC profile.
# - Operative DB holds ONLY copies of what the agent may use (sacrificial).
# - Personal DB is never referenced here.
#
# Uso: keygate-setup [--force | --reset-key]
#   --force: si la DB existe (corrupta, vieja, lo que sea), la MUEVE a
#            hermes.kdbx.corrupt-<timestamp> (SIN sufijo .bak a propósito: así la rotación
#            automática de backups (*.bak) jamás lo barre; nunca se borra en silencio)
#            y crea una nueva. El keyfile se REUTILIZA (tu .key descargado
#            sigue abriendo la nueva). Si querés keyfile nuevo también:
#            borrá ~/.keepass-agent.key a mano antes (responsabilidad tuya).
#   --reset-key: permite descargar el .key por la web UNA vez más. Borra la
#            bandera `.keygate-keyfile-served` (acción local explícita, requiere
#            shell en el host — jamás por web). Úsalo si perdiste tu copia del
#            .key. OJO: quien tenga la contraseña web podrá bajar el .key de
#            nuevo; es tu decisión consciente.
set -euo pipefail
FORCE=0; RESETKEY=0
for a in "$@"; do
  [ "$a" = "--force" ] && FORCE=1
  [ "$a" = "--reset-key" ] && RESETKEY=1
done
DB="${KEYGATE_DB:-$HOME/Documentos/hermes.kdbx}"
KF="${KEYGATE_KEYFILE:-$HOME/.keepass-agent.key}"
APROF="$HOME/.config/keepassxc-agent.ini"

# Reset del flag one-shot del .key. Se ejecuta SIEMPRE primero (antes de tocar
# la DB): si la DB operativa ya existe, el flujo historico hacia `exit 0` y el
# flag nunca se reseteaba -> `--reset-key` era un no-op silencioso y el .key
# quedaba irrecuperable desde la web.
reset_key_flag() {
  local flag
  flag="$(dirname "$DB")/.keygate-keyfile-served"
  if [ -f "$flag" ]; then
    rm -f "$flag"
    echo "-- one-shot .key flag REMOVED: la web permite descargar el .key una vez más (tu decisión)"
  else
    echo "-- one-shot .key flag no existía: nada que resetear"
  fi
}

if [ "$RESETKEY" = 1 ]; then
  reset_key_flag
fi

echo "== keygate setup =="
if [ ! -f "$KF" ]; then
  echo "-- creating keyfile $KF (0600)"
  head -c 64 /dev/urandom | base64 > "$KF"
  chmod 600 "$KF"
else
  echo "-- keyfile exists: $KF (se reutiliza: tu .key descargado sigue valiendo)"
fi
if [ -f "$DB" ]; then
  if [ "$FORCE" = 1 ]; then
    STAMP=$(date +%s)
    mv "$DB" "$DB.corrupt-$STAMP"
    chmod 600 "$DB.corrupt-$STAMP"
    echo "-- DB anterior movida a $(basename "$DB").corrupt-$STAMP (no se borró nada; la rotación *.bak no lo toca)"
  else
    echo "-- operative DB exists: $DB (usá --force para reemplazarla con respaldo)"
    # Estado de protección, sin preguntar: una DB existente no se puede
    # re-cifrar desde keepassxc-cli (eso se hace en la GUI).
    if timeout 10 keepassxc-cli ls -k "$KF" --no-password -q "$DB" >/dev/null 2>&1; then
      echo "--   protección actual: SOLO keyfile (.key) — abre sin contraseña"
      echo "--   ¿querés exigir además contraseña maestra? abrí la DB en KeePassXC:"
      echo "--     Database > Database Settings > Security > Add password"
      echo "--   (keepassxc-cli no puede añadir contraseña a una DB ya creada)"
    else
      echo "--   protección actual: keyfile + CONTRASEÑA maestra"
      echo "--   lecturas no interactivas: exportá KEYGATE_DB_PASSWORD en el entorno"
    fi
    exit 0
  fi
fi
# El directorio del vault puede no existir (server con home fresco, sin
# ~/Documentos): db-create falla con "No such file or directory" si no.
mkdir -p "$(dirname "$DB")"
# Protección de la base operativa: elección explícita en la instalación.
#   key      -> solo keyfile (histórico: abre sin prompt)
#   password -> keyfile + contraseña maestra (pide la contraseña al abrir)
DBPW_MODE="${KEYGATE_DB_PASSWORD_MODE:-ask}"
# --with-password / --keyfile-only permiten fijar el modo sin preguntar (CI,
# instalaciones desatendidas). Sin TTY no se pregunta nunca: default keyfile.
for a in "$@"; do
  [ "$a" = "--with-password" ] && DBPW_MODE=password
  [ "$a" = "--keyfile-only" ] && DBPW_MODE=key
done
if [ "$DBPW_MODE" = "ask" ]; then
  if [ -t 0 ]; then
    echo
    echo "¿Cómo se protege la base operativa $DB ?"
    echo "  1) Solo keyfile (.key)   -> abre sin prompt (por defecto)"
    echo "  2) Keyfile + contraseña  -> se pide la contraseña maestra al abrir"
    read -r -p "Opción [1]: " _opt || _opt=1
    case "${_opt:-1}" in
      2) DBPW_MODE=password ;;
      *) DBPW_MODE=key ;;
    esac
  else
    echo "-- sin terminal interactiva: se usa solo keyfile (usa --with-password para fijarlo)"
    DBPW_MODE=key
  fi
fi
if [ "$DBPW_MODE" = "password" ]; then
  echo "-- creating operative DB (keyfile + MASTER PASSWORD)"
  echo "   (se te pedirá la contraseña dos veces; no se guarda en disco ni en argv)"
  keepassxc-cli db-create --set-key-file "$KF" -p "$DB"
else
  echo "-- creating operative DB (keyfile-only, no master password)"
  keepassxc-cli db-create --set-key-file "$KF" "$DB"
fi
chmod 600 "$DB"
echo "-- add copies now: keepassxc \"$DB\"  (alias style: gh-agent-1, URL exacta, TOTP if needed)"
mkdir -p "$(dirname "$APROF")"
if [ ! -f "$APROF" ]; then
  cat > "$APROF" <<EOF
# Agent KeePassXC profile: long lock for operative DB only.
# Launch: keepassxc --config $APROF $DB
[General]
ConfigVersion=2
[Security]
LockDatabaseIdle=true
LockDatabaseIdleSeconds=28800
LockDatabaseScreenLock=true
ClearClipboardTimeout=10
EOF
  echo "-- agent profile written: $APROF"
  echo "-- launch: keepassxc --config $APROF \"$DB\" &"
else
  echo "-- agent profile exists: $APROF"
fi
echo "-- verify non-interactive read:"
if [ "$DBPW_MODE" = "password" ]; then
  echo "   la DB tiene contraseña maestra: para lecturas no interactivas exporta"
  echo "   KEYGATE_DB_PASSWORD en el entorno de Hermes (nunca en argv ni en el chat)."
  echo "   Prueba manual:  KEYGATE_DB_PASSWORD=... keepassxc-cli ls -k \"$KF\" -q \"$DB\""
else
  echo "   (must print entry list or empty, never prompt):"
  timeout 10 keepassxc-cli ls -k "$KF" --no-password -q "$DB" < /dev/null || echo "   (locked/missing ok: unlock in GUI, keyfile-only = 1 click)"
fi
echo "== done =="
